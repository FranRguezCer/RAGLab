# PostgreSQL settings consumed by Docker Compose.
POSTGRES_DB=raglab
POSTGRES_USER=raglab
POSTGRES_PASSWORD=raglab

# Shared PostgreSQL connection string for ingestion, retrieval, and generation.
# Keep its credentials and database name aligned with the POSTGRES_* values above.
RAGLAB_DSN=postgresql://raglab:raglab@127.0.0.1:5432/raglab

# Ollama settings consumed by raglab-generate.
# The embedding model must match the contract stored for the selected collection.
RAGLAB_GENERATION_MODEL=qwen3:4b
RAGLAB_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAGLAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAGLAB_NUM_CTX=12288
RAGLAB_KEEP_ALIVE=5m

# Optional embedding GPU override. Leave unset to let Ollama choose automatically.
# RAGLAB_EMBEDDING_NUM_GPU=1

# `raglab-demo share` generates its bearer token per session. Do not configure or persist it here.
# Prepared evidence is written below and is intentionally ignored by Git.
RAGLAB_DEMO_EVIDENCE=artifacts/demo/evidence.json
