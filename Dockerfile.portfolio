FROM python:3.12-slim AS runtime

ARG RAGLAB_BUILD_SHA
ARG RAGLAB_DEMO_RELEASE_SHA256
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RAGLAB_BUILD_SHA=${RAGLAB_BUILD_SHA} \
    RAGLAB_DEMO_RELEASE_SHA256=${RAGLAB_DEMO_RELEASE_SHA256} \
    RAGLAB_DEMO_RELEASE=/app/demo-release.json
WORKDIR /app

COPY pyproject.toml README.md ./
RUN mkdir -p src/raglab && touch src/raglab/__init__.py \
    && pip install --no-cache-dir .

COPY src ./src
COPY scripts ./scripts
COPY demo-release.json ./demo-release.json
RUN pip install --no-cache-dir --no-deps . \
    && chown -R 65532:65532 /app

USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "raglab.portfolio_cli:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
